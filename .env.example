# Plantilla segura para activacion controlada de Supabase.
# No pegar credenciales reales en chats ni commitear .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mantener en false hasta que tabla, Storage, RLS/policies y fallback esten
# validados en un entorno controlado.
NEXT_PUBLIC_CE_SUPABASE_ENABLED=false

# Google Maps real queda desactivado por defecto para evitar que una API key con
# facturacion/dominios restringidos muestre el aviso "For development purposes only".
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
